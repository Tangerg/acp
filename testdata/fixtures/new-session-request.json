{
  "type": "NewSessionRequest",
  "cases": [
    {
      "name": "minimal",
      "why": "the baseline: a working directory and an empty server list",
      "input": {
        "cwd": "/work",
        "mcpServers": []
      },
      "accepted": true,
      "normalized": {
        "cwd": "/work",
        "mcpServers": []
      }
    },
    {
      "name": "missing required array",
      "why": "mcpServers is required; absence cannot invent a server configuration",
      "input": {
        "cwd": "/work"
      },
      "accepted": false
    },
    {
      "name": "required array malformed",
      "why": "operation parameters must reject a non-array rather than remove configured servers",
      "input": {
        "cwd": "/work",
        "mcpServers": "none"
      },
      "accepted": false
    },
    {
      "name": "required array with an invalid item",
      "why": "a malformed server rejects the request instead of silently shrinking the tool set",
      "input": {
        "cwd": "/work",
        "mcpServers": [
          {
            "type": "http",
            "name": "a",
            "url": "https://a",
            "headers": []
          },
          {
            "type": "http",
            "name": "b"
          },
          {
            "name": "c",
            "command": "/bin/c",
            "args": [],
            "env": []
          }
        ]
      },
      "accepted": false
    },
    {
      "name": "optional array absent",
      "why": "an optional array's absent state is its own, and re-encoding must not invent an empty one",
      "input": {
        "cwd": "/work",
        "mcpServers": []
      },
      "accepted": true,
      "normalized": {
        "cwd": "/work",
        "mcpServers": []
      }
    },
    {
      "name": "optional array malformed",
      "why": "an invalid additionalDirectories value must not alter the workspace scope",
      "input": {
        "cwd": "/work",
        "mcpServers": [],
        "additionalDirectories": 3
      },
      "accepted": false
    },
    {
      "name": "optional array with an invalid item",
      "why": "invalid directory entries reject the request instead of silently narrowing its scope",
      "input": {
        "cwd": "/work",
        "mcpServers": [],
        "additionalDirectories": [
          "/a",
          7,
          "/b"
        ]
      },
      "accepted": false
    },
    {
      "name": "optional array empty",
      "why": "empty and absent are different: this one is present",
      "input": {
        "cwd": "/work",
        "mcpServers": [],
        "additionalDirectories": []
      },
      "accepted": true,
      "normalized": {
        "cwd": "/work",
        "additionalDirectories": [],
        "mcpServers": []
      }
    },
    {
      "name": "every server arm",
      "why": "the published stable union has two tagged arms and one untagged arm",
      "input": {
        "cwd": "/work",
        "mcpServers": [
          {
            "type": "http",
            "name": "h",
            "url": "https://h",
            "headers": [
              {
                "name": "A",
                "value": "b"
              }
            ]
          },
          {
            "type": "sse",
            "name": "s",
            "url": "https://s",
            "headers": []
          },
          {
            "name": "d",
            "command": "/bin/d",
            "args": [
              "--x"
            ],
            "env": [
              {
                "name": "K",
                "value": "v"
              }
            ]
          }
        ]
      },
      "accepted": true,
      "normalized": {
        "cwd": "/work",
        "mcpServers": [
          {
            "name": "h",
            "url": "https://h",
            "headers": [
              {
                "name": "A",
                "value": "b"
              }
            ],
            "type": "http"
          },
          {
            "name": "s",
            "url": "https://s",
            "headers": [],
            "type": "sse"
          },
          {
            "name": "d",
            "command": "/bin/d",
            "args": [
              "--x"
            ],
            "env": [
              {
                "name": "K",
                "value": "v"
              }
            ]
          }
        ]
      }
    },
    {
      "name": "server arm with an unknown tag",
      "why": "no union arm accepts the server, so the operation request is rejected",
      "input": {
        "cwd": "/work",
        "mcpServers": [
          {
            "type": "quantum",
            "name": "q"
          },
          {
            "name": "d",
            "command": "/bin/d",
            "args": [],
            "env": []
          }
        ]
      },
      "accepted": false
    },
    {
      "name": "missing required string",
      "why": "a required string is required even though its empty value is valid",
      "input": {
        "mcpServers": []
      },
      "accepted": false
    },
    {
      "name": "required string empty",
      "why": "the schema states no minimum length, so the empty string is a value and not an absence",
      "input": {
        "cwd": "",
        "mcpServers": []
      },
      "accepted": true,
      "normalized": {
        "cwd": "",
        "mcpServers": []
      }
    },
    {
      "name": "null stdio argument and environment lists default to empty",
      "why": "x-deserialize-default-on-null preserves the published defaults without accepting other malformed values",
      "input": {
        "cwd": "/work",
        "mcpServers": [
          {
            "name": "stdio",
            "command": "/bin/server",
            "args": null,
            "env": null
          }
        ]
      },
      "accepted": true,
      "normalized": {
        "cwd": "/work",
        "mcpServers": [
          {
            "name": "stdio",
            "command": "/bin/server",
            "args": [],
            "env": []
          }
        ]
      }
    }
  ]
}
