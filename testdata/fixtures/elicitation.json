        "url": "https://example.invalid/sign-in",
        "mode": "url",
        "message": "sign in"
      }
    },
    {
      "name": "a url elicitation scoped to a request",
      "type": "CreateElicitationRequest",
      "why": "both scopes exist under both modes, so all four combinations are legal",
      "input": {
        "message": "sign in",
        "mode": "url",
        "elicitationId": "elicit-1",
        "url": "https://example.invalid/sign-in",
        "requestId": 9
