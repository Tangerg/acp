      "accepted": true,
      "normalized": {
        "requestId": 7,
        "requestedSchema": {
          "type": "object",
          "properties": {}
        },
        "mode": "form",
        "message": "paste your token"
      }
    },
    {
      "name": "a request-scoped elicitation under a string request id",
      "type": "CreateElicitationRequest",
      "why": "a JSON-RPC id may be a string or a number, and the scope carries whichever the call used",
      "input": {
        "message": "paste your token",
        "mode": "form",
        "requestedSchema": {
          "type": "object",
          "properties": {}
        },
        "requestId": "c276409b"
      },
      "accepted": true,
      "normalized": {
        "requestId": "c276409b",
        "requestedSchema": {
          "type": "object",
          "properties": {}
        },
        "mode": "form",
        "message": "paste your token"
      }
    },
    {
      "name": "a url elicitation scoped to a session",
      "type": "CreateElicitationRequest",
      "why": "the mode answered twice: once by the response and again by elicitation/complete",
      "input": {
        "message": "sign in",
        "mode": "url",
        "elicitationId": "elicit-1",
        "url": "https://example.invalid/sign-in",
        "sessionId": "sess-1"
      },
      "accepted": true,
      "normalized": {
        "sessionId": "sess-1",
