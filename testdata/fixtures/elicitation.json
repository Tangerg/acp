    {
      "name": "a mode no version of the schema defines",
      "type": "CreateElicitationRequest",
      "why": "the catch-all arm is how a mode from a later release survives being decoded; it carries a scope like every other arm",
      "input": {
        "message": "think at me",
        "mode": "telepathy",
        "channel": "alpha",
        "sessionId": "sess-1"
      },
      "accepted": true,
      "normalized": {
        "sessionId": "sess-1",
        "mode": "telepathy",
        "message": "think at me",
        "channel": "alpha"
      }
    },
    {
      "name": "a custom mode whose session scope is not a session scope",
      "type": "CreateElicitationRequest",
      "why": "an alternative is satisfied by decoding as it, not by naming the properties it requires",
      "input": {
        "message": "think at me",
        "mode": "telepathy",
        "sessionId": 1
      },
      "accepted": false
    },
    {
      "name": "a custom mode whose request scope is not a request scope",
      "type": "CreateElicitationRequest",
      "why": "the same for the other alternative: a JSON-RPC id is a string, a number or null",
      "input": {
        "message": "think at me",
        "mode": "telepathy",
        "requestId": {}
      },
      "accepted": false
    },
    {
      "name": "a form elicitation with no scope",
