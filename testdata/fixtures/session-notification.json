              "content": "first",
              "priority": "high",
              "status": "pending"
            },
            {
              "content": "second",
              "priority": "low",
              "status": "completed"
            }
          ],
          "sessionUpdate": "plan"
        }
      }
    },
    {
      "name": "a plan update, whose content is another union",
      "why": "plan_update is not part of the published stable schema",
      "input": {
        "sessionId": "sess-1",
        "update": {
          "sessionUpdate": "plan_update",
          "plan": {
            "type": "markdown",
            "planId": "plan-1",
            "content": "# steps"
          }
        }
      },
      "accepted": false
    },
    {
      "name": "a plan removal",
      "why": "plan_removed is not part of the published stable schema",
      "input": {
        "sessionId": "sess-1",
        "update": {
          "sessionUpdate": "plan_removed",
          "planId": "plan-1"
        }
      },
      "accepted": false
    },
    {
