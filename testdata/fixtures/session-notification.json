{
  "type": "SessionNotification",
  "$comment": "session/update carries the whole of a turn's output, and its update property is the schema's largest union: fifteen arms, three of which share one payload. It is the message this SDK sends most, so it is the one the corpus covers most closely.",
  "cases": [
    {
      "name": "a message chunk",
      "why": "the tag is the only thing separating three arms that carry the same payload",
      "input": {
        "sessionId": "sess-1",
        "update": {
          "sessionUpdate": "agent_message_chunk",
          "content": {
            "type": "text",
            "text": "hello"
          }
        }
      },
      "accepted": true,
      "normalized": {
        "sessionId": "sess-1",
        "update": {
          "content": {
            "text": "hello",
            "type": "text"
          },
          "sessionUpdate": "agent_message_chunk"
        }
      }
    },
    {
      "name": "the other two chunk arms",
      "why": "each must round-trip to its own tag rather than to whichever arm was tried first",
      "input": {
        "sessionId": "sess-1",
        "update": {
          "sessionUpdate": "user_message_chunk",
          "content": {
            "type": "text",
            "text": "ask"
          },
          "messageId": "m-1"
        }
      },
      "accepted": true,
      "normalized": {
        "sessionId": "sess-1",
        "update": {
          "content": {
            "text": "ask",
            "type": "text"
          },
          "messageId": "m-1",
          "sessionUpdate": "user_message_chunk"
        }
      }
    },
    {
      "name": "a thought chunk",
      "why": "the third arm sharing ContentChunk",
      "input": {
        "sessionId": "sess-1",
        "update": {
          "sessionUpdate": "agent_thought_chunk",
          "content": {
            "type": "text",
            "text": "thinking"
          }
        }
      },
      "accepted": true,
      "normalized": {
        "sessionId": "sess-1",
        "update": {
          "content": {
            "text": "thinking",
            "type": "text"
          },
          "sessionUpdate": "agent_thought_chunk"
        }
      }
    },
    {
      "name": "a tool call",
      "why": "an arm whose payload no other arm shares, so the payload type is the arm",
      "input": {
        "sessionId": "sess-1",
        "update": {
          "sessionUpdate": "tool_call",
          "toolCallId": "call-1",
          "title": "Read a file",
          "kind": "read",
          "status": "in_progress",
          "locations": [
            {
              "path": "/a",
              "line": 12
            }
          ],
          "rawInput": {
            "path": "/a"
          }
        }
      },
      "accepted": true,
      "normalized": {
        "sessionId": "sess-1",
        "update": {
          "toolCallId": "call-1",
          "title": "Read a file",
          "kind": "read",
          "status": "in_progress",
          "locations": [
            {
              "path": "/a",
              "line": 12
            }
          ],
          "rawInput": {
            "path": "/a"
          },
          "sessionUpdate": "tool_call"
        }
      }
    },
    {
      "name": "a tool call with every content arm",
      "why": "ToolCallContent has three arms, one of which nests another union",
      "input": {
        "sessionId": "sess-1",
        "update": {
          "sessionUpdate": "tool_call",
          "toolCallId": "call-1",
          "title": "Do work",
          "content": [
            {
              "type": "content",
              "content": {
                "type": "text",
                "text": "out"
              }
            },
            {
              "type": "diff",
              "path": "/a",
              "oldText": "before",
              "newText": "after"
            },
            {
              "type": "terminal",
              "terminalId": "term-1"
            }
          ]
        }
      },
      "accepted": true,
      "normalized": {
        "sessionId": "sess-1",
        "update": {
          "toolCallId": "call-1",
          "title": "Do work",
          "content": [
            {
              "content": {
                "text": "out",
                "type": "text"
              },
              "type": "content"
            },
            {
              "path": "/a",
              "oldText": "before",
              "newText": "after",
              "type": "diff"
            },
            {
              "terminalId": "term-1",
              "type": "terminal"
            }
          ],
          "sessionUpdate": "tool_call"
        }
      }
    },
    {
      "name": "a tool call update",
      "why": "its payload is also an ordinary property of RequestPermissionRequest, so the payload cannot own the tag",
      "input": {
        "sessionId": "sess-1",
        "update": {
          "sessionUpdate": "tool_call_update",
          "toolCallId": "call-1",
          "status": "completed"
        }
      },
      "accepted": true,
      "normalized": {
        "sessionId": "sess-1",
        "update": {
          "toolCallId": "call-1",
          "status": "completed",
          "sessionUpdate": "tool_call_update"
        }
      }
    },
    {
      "name": "an unknown tool kind is salvaged",
      "why": "kind carries x-deserialize-default-on-error with no declared default, so it recovers to absent",
      "input": {
        "sessionId": "sess-1",
        "update": {
          "sessionUpdate": "tool_call",
          "toolCallId": "call-1",
          "title": "t",
          "kind": "telepathy"
        }
      },
      "accepted": true,
      "normalized": {
        "sessionId": "sess-1",
        "update": {
          "toolCallId": "call-1",
          "title": "t",
          "sessionUpdate": "tool_call"
        }
      }
    },
    {
      "name": "an invalid content item is dropped",
      "why": "the content array carries x-deserialize-skip-invalid-items",
      "input": {
        "sessionId": "sess-1",
        "update": {
          "sessionUpdate": "tool_call",
          "toolCallId": "call-1",
          "title": "t",
          "content": [
            {
              "type": "diff",
              "path": "/a",
              "newText": "x"
            },
            {
              "type": "diff",
              "path": "/b"
            },
            {
              "type": "terminal",
              "terminalId": "term-1"
            }
          ]
        }
      },
      "accepted": true,
      "normalized": {
        "sessionId": "sess-1",
        "update": {
          "toolCallId": "call-1",
          "title": "t",
          "content": [
            {
              "path": "/a",
              "newText": "x",
              "type": "diff"
            },
            {
              "terminalId": "term-1",
              "type": "terminal"
            }
          ],
          "sessionUpdate": "tool_call"
        }
      }
    },
    {
      "name": "a plan",
